# Copy this file to .env and fill in values as needed.
# All values have sensible defaults in config/settings.py, so .env is
# only required to override a default or to supply an LLM API key.

# ----------------------------------------------------------------------
# LLM Coaching (Step 10) — optional. Without a key, the system falls
# back to rule-based coaching automatically.
# ----------------------------------------------------------------------
LLM_PROVIDER=gemini

GOOGLE_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=30

# ----------------------------------------------------------------------
# Behaviour Detection Thresholds
# ----------------------------------------------------------------------
AGGRESSIVE_ACCEL_THRESHOLD=2.5     # m/s^2
HARSH_BRAKE_THRESHOLD=-3.0         # m/s^2
IDLE_SPEED_THRESHOLD=1.0           # km/h
EXCESSIVE_IDLE_SECONDS=180
DEFAULT_SPEED_LIMIT=80             # km/h (arterial fallback)
HIGHWAY_SPEED_LIMIT=100            # km/h
CITY_SPEED_LIMIT=60                # km/h
OVERSPEED_TOLERANCE=5              # km/h
RAPID_HEADING_CHANGE=20            # degrees/second
SHARP_CORNER_LATERAL_ACCEL=3.0     # m/s^2
HIGHWAY_SPEED_FLOOR=80             # km/h
CITY_SPEED_CEILING=60              # km/h
NIGHT_START_HOUR=21
NIGHT_END_HOUR=5
MIN_TRIP_POINTS=10
MIN_TRIP_DISTANCE_KM=0.3
GPS_JUMP_SPEED_KMH=200

# ----------------------------------------------------------------------
# API server
# ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8009
