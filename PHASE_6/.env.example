# ---------------------------------------------------------------------------
# Vehicle Knowledge Base (RAG) - Environment Configuration
#
# Copy this file to `.env` in the project root and fill in the values you
# need. Every variable has a working default in app/config.py, so you only
# need to set GOOGLE_API_KEY to get started.
# ---------------------------------------------------------------------------

# --- Generation (Gemini) ----------------------------------------------------
# Required to call the LLM. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Vector database ---------------------------------------------------------
# Folder where the persisted ChromaDB collection is written/read.
# (PERSIST_DIR is also accepted as an alias for this same setting.)
CHROMA_DB=./vectordb/chroma_db

# --- Embeddings ---------------------------------------------------------
# HuggingFace / sentence-transformers model id used for both ingestion and
# query-time embedding. Must stay the same across both, or vectors will not
# be comparable.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Retrieval -----------------------------------------------------------
# Default number of chunks returned per query (can be overridden per-request
# via the API's `top_k` field).
TOP_K=5

# --- Chunking -----------------------------------------------------------
# Characters per chunk, and character overlap between consecutive chunks.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---------------------------------------------------------------------------
# Additional optional settings (uncomment to override defaults)
# ---------------------------------------------------------------------------
# DATA_DIR=data
# COLLECTION_NAME=vehicle_knowledge_base
# EMBEDDING_DEVICE=cpu
# SIMILARITY_THRESHOLD=0.8
# SEARCH_TYPE=similarity
# LLM_MODEL=gemini-1.5-flash
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=3
# LOG_LEVEL=INFO
